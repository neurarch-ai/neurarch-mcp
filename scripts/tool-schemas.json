      "seq_len": {
        "type": "integer"
      },
      "gpu": {
        "type": "string"
      },
      "schedule": {
        "type": "string",
        "enum": [
          "1f1b",
          "interleaved"
        ]
      },
      "virtual_stages": {
        "type": "integer"
      },

          "concise",
          "full"
        ]
      },
      "limit": {
        "type": "integer",
        "description": "Page size."
      },
      "cursor": {
        "type": "string",
        "description": "Previous nextCursor."
      },
      "model_path": {
        "type": "string",
        "description": "File, zoo:<id>, hf:<org/name>"
      }

  "trace_model": {
    "type": "object",
    "properties": {
      "target": {
        "type": "string",
        "description": "\"path/to/model.py:ClassName\", \"pkg.module:factory\", or \"hf:org/name\"."
      },
      "input": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "Input dims, batch first, one per input: [\"1,3,224,224\"]. \":long\" for token ids."
      },
      "dtype": {
        "type": "string",
        "description": "Input dtype (float32; long for hf:)."

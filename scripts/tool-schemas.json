{
  "size_training_job": {
    "type": "object",
    "properties": {
      "batch_size": {
        "type": "integer",
        "minimum": 1,
        "description": "Global batch."
      },
      "gpu": {
        "type": "string",
        "description": "\"A100-40\", \"8xH100\"."
      },
      "seq_len": {
        "type": "integer",
        "minimum": 1,
        "description": "Default 2048."
      },
      "attention": {
        "type": "string",
        "enum": [
          "sdpa",
          "flash",
          "eager"
        ],
        "description": "Default sdpa."
      },
      "hf_id": {
        "type": "string",
        "description": "org/name. Needs --hf."
      },
      "epochs": {
        "type": "integer",
        "minimum": 1,
        "description": "Default 10."
      },
      "samples": {
        "type": "integer",
        "minimum": 1,
        "description": "Per epoch (default 50,000)."
      },
      "data": {
        "type": "object",
        "description": "seq_len, tokenizer_size, num_classes, image_size, channels"
      },
      "model_path": {
        "type": "string",
        "description": "File, zoo:<id>, hf:<org/name>"
      }
    },
    "required": [
      "batch_size"
    ],
    "additionalProperties": false
  },
  "diagnose_oom": {
    "type": "object",
    "properties": {
      "error": {
        "type": "string",
        "description": "The OOM text as printed."
      },
      "hf_id": {
        "type": "string"
      },
      "batch": {
        "type": "integer",
        "minimum": 1
      },
      "seq_len": {
        "type": "integer",
        "minimum": 1,
        "description": "The prompt, if inference."
      },
      "step": {
        "type": "integer",
        "minimum": 0
      },
      "attention": {
        "type": "string",
        "enum": [
          "sdpa",
          "flash",
          "eager"
        ]
      },
      "inference": {
        "type": "boolean",
        "description": "Generation, not training."
      },
      "gen_tokens": {
        "type": "integer",
        "minimum": 0,
        "description": "Default 256."
      },
      "model_path": {
        "type": "string",
        "description": "File, zoo:<id>, hf:<org/name>"
      }
    },
    "required": [
      "error"
    ],
    "additionalProperties": false
  },
  "check_edit": {
    "type": "object",

  "rank_designs": {
    "type": "object",
    "properties": {
      "candidates": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Label in the result."
            },
            "model_path": {
              "type": "string",
              "description": "File, zoo:<id>, hf:<org/name>"
            },
            "model": {
              "type": "object",
              "description": "Inline graph instead of a path."
            }
          },
          "additionalProperties": false
        },
        "description": "Designs to order; each needs model_path or model."
      },
      "include_current": {
        "type": "boolean",
        "description": "Also rank this server's model as \"current\"."
      },
      "tie_break": {
        "type": "string",
        "enum": [
          "none",
          "cost",
          "params"
        ],
        "description": "Break a measured tie only."
      },
      "model_path": {
        "type": "string",
        "description": "File, zoo:<id>, hf:<org/name>"
      }
    },
    "required": [
      "candidates"
    ],
    "additionalProperties": false
  },

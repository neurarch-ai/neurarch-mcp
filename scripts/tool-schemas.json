          "type": "string"
        }
      },
      "batch": {
        "type": "integer",
        "minimum": 1
      },
      "seq_len": {
        "type": "integer",
        "minimum": 1
      },
      "gpu": {
        "type": "string"
      },
      "attention": {
        "type": "string",
        "enum": [
          "sdpa",
          "flash",
          "eager"
        ]
      },
      "model_path": {
        "type": "string",
        "description": "File, zoo:<id>, hf:<org/name>"
      }
    },
    "additionalProperties": false
  },
  "check_parallel_layout": {
    "type": "object",
    "properties": {
      "tp": {
        "type": "integer"
      },
      "pp": {
        "type": "integer"

        "type": "string",
        "description": "Write the graph here (--write)."
      },
      "timeout_s": {
        "type": "integer",
        "minimum": 5,
        "maximum": 600,
        "description": "Seconds (default 120)."
      },
      "model_path": {
        "type": "string",
        "description": "File, zoo:<id>, hf:<org/name>"
      }
    },
    "required": [
      "target",
      "input"
    ],
    "additionalProperties": false
  },
  "plan": {
    "type": "object",
    "properties": {
      "policy": {
        "type": "object",
        "description": "House rules (max_params, max_memory_gb, must_fit, forbid_types, max_cost_usd, ...). Replaces .neurarch.yml.",
        "additionalProperties": true
      },
      "base_path": {
        "type": "string",
        "description": "A second model to diff against."
      },
      "spec": {
        "type": "object",
        "description": "{ base?, adapter?: { peft, rank, targets[] }, quant?, serving?, constraints? }: a change section gated on memory, fit and policy.",
        "additionalProperties": true
      },
      "seq_len": {
        "type": "integer",
        "minimum": 1,
        "description": "Default 2048."
      },
      "model_path": {
        "type": "string",
        "description": "File, zoo:<id>, hf:<org/name>"
      }
    },
    "additionalProperties": false
  },
  "history": {
    "type": "object",
    "properties": {
      "fingerprint": {
        "type": "string",
        "description": "8 hex characters, from a plan result (plan.model.fingerprint). Skips loading a graph."
      },
      "model_path": {
        "type": "string",
        "description": "File, zoo:<id>, hf:<org/name>"
      }
    },
    "additionalProperties": false
  }
}

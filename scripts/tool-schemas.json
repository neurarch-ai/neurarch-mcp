      "gpu": {
        "type": "string"
      },
      "gpus": {
        "type": "integer"
      },
      "against": {
        "type": "string",
        "description": "Model it replaces."
      },
      "model_path": {
        "type": "string",
        "description": "File, zoo:<id>, hf:<org/name>"
      }
    },
    "additionalProperties": false
  },
  "check_pins": {
    "type": "object",
    "properties": {
      "paths": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Files or dirs. Default \".\"."
      },
      "source": {
        "type": "string",
        "description": "File text, instead of paths."
      },
      "filename": {
        "type": "string",
        "description": "For source, e.g. train.py."
      },
      "include_dynamic": {
        "type": "boolean",
        "description": "List ids held in variables."
      },
      "limit": {
        "type": "integer",
        "description": "Page size."
      },
      "cursor": {
        "type": "string",
        "description": "Previous nextCursor."
      },
      "model_path": {
        "type": "string",
        "description": "File, zoo:<id>, hf:<org/name>"
      }
    },
    "additionalProperties": false
  },
  "model_changes": {
    "type": "object",
    "properties": {
      "hf_id": {
        "type": "string",
        "description": "e.g. \"Qwen/Qwen3-8B\"."

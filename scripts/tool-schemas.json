      "activation_checkpointing": {
        "type": "boolean"
      },
      "seq_len_histogram": {
        "type": [
          "array",
          "string"
        ]
      },
      "model_path": {
        "type": "string",
        "description": "File, zoo:<id>, hf:<org/name>"
      }
    },
    "required": [
      "micro_batch",
      "seq_len"
    ],
    "additionalProperties": false
  },
  "check_serving_config": {
    "type": "object",
    "properties": {
      "command": {
        "type": "string",
